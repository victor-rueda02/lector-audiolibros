    "pdfkit": "^0.20.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "pdfjs-dist": "^6.4.299"
